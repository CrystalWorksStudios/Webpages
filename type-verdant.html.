

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Verdant</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Playfair+Display:wght@600;700&display=swap');

*{box-sizing:border-box;margin:0;padding:0}

body{
    background:#f1f4e9;
    color:#20352a;
    font-family:"DM Sans",sans-serif;
}

nav{
    max-width:1200px;
    margin:auto;
    padding:25px 5%;
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.logo{
    font-family:"Playfair Display";
    font-size:25px;
}

.links{
    display:flex;
    gap:30px;
}

.links a{
    color:#456052;
    text-decoration:none;
}

.menu{display:none}

.hero{
    max-width:1200px;
    margin:auto;
    padding:100px 5% 140px;
}

.eyebrow{
    color:#668c63;
    text-transform:uppercase;
    letter-spacing:3px;
    font-size:12px;
}

h1{
    font-family:"Playfair Display";
    font-size:clamp(55px,9vw,110px);
    line-height:.95;
    max-width:900px;
    margin:25px 0;
}

h1 em{
    color:#71936a;
    font-weight:600;
}

.hero p{
    max-width:600px;
    color:#617166;
    line-height:1.8;
    font-size:17px;
}

.button{
    display:inline-block;
    margin-top:30px;
    padding:15px 25px;
    border-radius:50px;
    background:#294b37;
    color:white;
    text-decoration:none;
}

.grid{
    max-width:1200px;
    margin:auto;
    padding:0 5% 100px;
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:25px;
}

.card{
    background:#fff;
    border-radius:30px;
    padding:35px;
    min-height:250px;
    box-shadow:0 15px 40px rgba(37,62,45,.08);
}

.number{
    color:#83a17a;
    font-size:14px;
}

.card h2{
    font-family:"Playfair Display";
    margin:55px 0 15px;
}

.card p{
    color:#718077;
    line-height:1.7;
}

footer{
    text-align:center;
    padding:30px;
    color:#748078;
}

@media(max-width:700px){
    .links{display:none}
    .menu{display:block;font-size:24px}
    .grid{grid-template-columns:1fr}
}
</style>
</head>

<body>

<nav>
<div class="logo">Verdant.</div>
<div class="links">
<a href="#">Home</a>
<a href="#">Journal</a>
<a href="#">Studio</a>
</div>
<div class="menu">☰</div>
</nav>

<section class="hero">
<div class="eyebrow">Independent digital studio</div>
<h1>Design inspired by <em>nature.</em></h1>
<p>
Quiet interfaces, thoughtful digital experiences and beautiful
websites built with simplicity at their core.
</p>
<a class="button" href="#services">Discover</a>
</section>

<section class="grid" id="services">

<div class="card">
<div class="number">01</div>
<h2>Strategy</h2>
<p>Ideas transformed into clear digital directions.</p>
</div>

<div class="card">
<div class="number">02</div>
<h2>Design</h2>
<p>Human-centered interfaces with character and purpose.</p>
</div>

<div class="card">
<div class="number">03</div>
<h2>Development</h2>
<p>Fast, responsive experiences engineered for the modern web.</p>
</div>

</section>

<footer>© 2026 CWS</footer>

</body>
</html>
```
